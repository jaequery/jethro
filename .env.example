# Neon Postgres and the private Vercel Blob store. `vercel env pull` writes these
# (and more) to .env.local; set them here only when not using the Vercel CLI.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# BLOB_READ_WRITE_TOKEN=
# Local pipeline logs, and captured images when BLOB_READ_WRITE_TOKEN is unset.
SQRAP_DATA_DIR=./data
# Claude vision quality gate and tagging.
ANTHROPIC_API_KEY=
# Model for judging and tagging.
SQRAP_JUDGE_MODEL=claude-sonnet-5-5
# Web search for site discovery.
BRAVE_API_KEY=
# Sites scoring below this (1–10) are rejected.
SQRAP_MIN_QUALITY=7
# Purging a site's cached images from Vercel's CDN when it leaves public view, from
# outside Vercel (local admin, `npm run judge`, local pipeline). Without them the purge
# is queued in pending_purge and the cron route does it. Project and team ids are
# projectId and orgId in .vercel/project.json; VERCEL_TEAM_ID only for a team project.
# VERCEL_PURGE_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# Local admin at /admin (loopback requests only). Never set this on a hosted deployment.
# SQRAP_ADMIN=1
# Google sign-in (optional; the button is hidden without both). Redirect URI: <origin>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Image embeddings for find_similar (cohere/embed-v4.0 through Vercel AI Gateway):
# the Vercel OIDC token from `vercel env pull`, or an AI Gateway key.
# AI_GATEWAY_API_KEY=
# Another OpenAI-compatible /embeddings endpoint, e.g. a local stub (default https://ai-gateway.vercel.sh/v1).
# AI_GATEWAY_BASE_URL=
# Agent API (/api/v1) quota counters: Upstash Redis from the Vercel Marketplace
# sets KV_REST_API_URL/KV_REST_API_TOKEN (UPSTASH_REDIS_REST_URL/_TOKEN work too).
# Without them the counters are in memory, per server instance.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Calls per API key per UTC day (default 1000).
# SQRAP_API_DAILY_QUOTA=1000
